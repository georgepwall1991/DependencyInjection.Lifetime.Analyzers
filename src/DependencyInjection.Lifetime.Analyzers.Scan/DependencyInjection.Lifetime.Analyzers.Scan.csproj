<Project Sdk="Microsoft.NET.Sdk">

  <!-- The analyzer package's version is the single source of truth, so the scanner ships under
       the same version without a second number to bump. -->
  <PropertyGroup>
    <_DiAnalyzerProject>$(MSBuildThisFileDirectory)..\DependencyInjection.Lifetime.Analyzers\DependencyInjection.Lifetime.Analyzers.csproj</_DiAnalyzerProject>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_DiAnalyzerProject)')), '(?&lt;=&lt;Version&gt;)[^&lt;]+').Value)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>di-scan</ToolCommandName>
    <PackageId>DependencyInjection.Lifetime.Analyzers.Scan</PackageId>
    <Title>di-scan — DI lifetime scanner for .NET solutions</Title>
    <Authors>George Wall</Authors>
    <Copyright>Copyright (c) George Wall and contributors 2026</Copyright>
    <Description>di-scan builds any .NET solution with DependencyInjection.Lifetime.Analyzers injected, without changing its project files, and reports Microsoft.Extensions.DependencyInjection lifetime problems with ruleId path:line:column, surrounding source, SARIF, HTML, Markdown, baselines, and CI severity gates.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/georgepwall1991/DependencyInjection.Lifetime.Analyzers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://georgepwall1991.github.io/DependencyInjection.Lifetime.Analyzers/scanner/</PackageProjectUrl>
    <PackageTags>dependency-injection;di;ioc;lifetime;singleton;scoped;transient;captive-dependency;scope-leak;roslyn;roslyn-analyzer;analyzer;dotnet-tool;di-scan;sarif;code-scanning;static-analysis;false-positives;ci;github-actions;microsoft-extensions-dependencyinjection;aspnetcore;worker-service</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == ''">NuGet search polish: the package title, description, tags, and project URL now target di-scan and the scanner guide. No behavior changes.</PackageReleaseNotes>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="DependencyInjection.Lifetime.Analyzers.Tests" />
  </ItemGroup>

  <!-- Build the analyzer first and ship its assembly inside the tool, so a scan needs no package
       restore and always runs the analyzers this tool version was released with. -->
  <ItemGroup>
    <ProjectReference Include="..\DependencyInjection.Lifetime.Analyzers\DependencyInjection.Lifetime.Analyzers.csproj" ReferenceOutputAssembly="false" OutputItemType="_DiAnalyzerAssembly" />
  </ItemGroup>

  <Target Name="_IncludeDiAnalyzer" AfterTargets="ResolveProjectReferences" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Include="@(_DiAnalyzerAssembly)" Link="analyzer\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
