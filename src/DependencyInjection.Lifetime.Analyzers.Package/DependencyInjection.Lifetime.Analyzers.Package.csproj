<Project Sdk="Microsoft.NET.Sdk">

  <!-- The analyzer project's version is the single source of truth. This pack project adds the
       profiles and rule docs to the analyzer assembly without a second number to bump. -->
  <PropertyGroup>
    <_DiAnalyzerProject>$(MSBuildThisFileDirectory)..\DependencyInjection.Lifetime.Analyzers\DependencyInjection.Lifetime.Analyzers.csproj</_DiAnalyzerProject>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_DiAnalyzerProject)')), '(?&lt;=&lt;Version&gt;)[^&lt;]+').Value)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>DependencyInjection.Lifetime.Analyzers</PackageId>
    <Title>DependencyInjection Lifetime Analyzers — Roslyn DI captive dependency and scope leak analyzer</Title>
    <Authors>George Wall</Authors>
    <Copyright>Copyright (c) 2024-2026 George Wall</Copyright>
    <Description>38 compile-time Roslyn diagnostics for Microsoft.Extensions.DependencyInjection: a dependency injection lifetime analyzer covering captive dependencies, DI scope leaks, BuildServiceProvider misuse, circular dependencies, and unresolvable services in ASP.NET Core and .NET apps—before runtime. No runtime dependency. Ships starter editorconfig profiles and the di-scan tool for scanning existing repositories.</Description>
    <PackageTags>dependency-injection;di;ioc;lifetime;service-lifetime;singleton;scoped;transient;captive-dependency;captive-dependencies;scope-leak;CreateScope;CreateAsyncScope;BuildServiceProvider;IServiceCollection;IServiceProvider;IServiceScope;service-locator;ActivatorUtilities;microsoft-extensions-dependencyinjection;aspnetcore;aspnet-core;worker-service;generic-host;roslyn;roslyn-analyzer;roslyn-diagnostics;dotnet-analyzer;analyzers;static-analysis;code-fix;compile-time;csharp;dotnet;di-scan;dotnet-tool;sarif;code-scanning</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == ''">NuGet search and packaging polish: the analyzer description now names the dependency injection lifetime analyzer explicitly, and the di-scan package title, description, and project URL target the scanner query. No analyzer behavior changes.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/georgepwall1991/DependencyInjection.Lifetime.Analyzers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://georgepwall1991.github.io/DependencyInjection.Lifetime.Analyzers/</PackageProjectUrl>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DependencyInjection.Lifetime.Analyzers\DependencyInjection.Lifetime.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\PACKAGE_README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\**\*" Pack="true" PackagePath="assets\" />
    <None Include="..\..\profiles\*.editorconfig" Pack="true" PackagePath="contentFiles/any/any/profiles" />
    <None Include="..\..\docs\rules\*.md" Pack="true" PackagePath="docs/rules\" />
    <None Include="..\DependencyInjection.Lifetime.Analyzers\bin\$(Configuration)\netstandard2.0\DependencyInjection.Lifetime.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
