<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RootNamespace>DependencyInjection.Lifetime.Analyzers</RootNamespace>
    <AssemblyName>DependencyInjection.Lifetime.Analyzers</AssemblyName>
    <!-- RS1038 is expected for combined analyzer+code-fix assemblies that reference Workspaces. -->
    <NoWarn>$(NoWarn);RS1038</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DependencyInjection.Lifetime.Analyzers</PackageId>
    <Version>3.10.0</Version>
    <Authors>George Wall</Authors>
    <Title>DependencyInjection.Lifetime.Analyzers — DI captive dependency and scope leak analyzer</Title>
    <Description>38 compile-time Roslyn diagnostics for Microsoft.Extensions.DependencyInjection: a dependency injection lifetime analyzer covering captive dependencies, DI scope leaks, BuildServiceProvider misuse, circular dependencies, and unresolvable services in ASP.NET Core and .NET apps—before runtime. No runtime dependency. Ships starter editorconfig profiles and the di-scan tool for scanning existing repositories.</Description>
    <PackageTags>dependency-injection;di;dependency-injection-analyzer;di-analyzer;ioc;lifetime;service-lifetime;singleton;scoped;transient;captive-dependency;captive-dependencies;scope-leak;CreateScope;CreateAsyncScope;BuildServiceProvider;IServiceCollection;IServiceProvider;IServiceScope;service-locator;ActivatorUtilities;microsoft-extensions-dependencyinjection;aspnetcore;aspnet-core;worker-service;generic-host;roslyn;roslyn-analyzer;roslyn-diagnostics;dotnet-analyzer;analyzers;static-analysis;code-fix;compile-time;csharp;dotnet;di-scan;dotnet-tool;sarif;code-scanning</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == ''">Scanner UX and maintenance release: di-scan gains --fix and --update-baseline, Windows/macOS scanner CI, false-positive/negative issue forms, a second mutation shard, and dedicated scanner/blog/upgrading docs. No analyzer behavior changes.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/georgepwall1991/DependencyInjection.Lifetime.Analyzers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/georgepwall1991/DependencyInjection.Lifetime.Analyzers</PackageProjectUrl>
    <Copyright>Copyright (c) 2024-2026 George Wall</Copyright>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\PACKAGE_README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\**\*" Pack="true" PackagePath="assets\" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
